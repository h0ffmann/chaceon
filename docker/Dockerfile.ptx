# syntax=docker/dockerfile:1
# Compiles rust/gpu-cuda to PTX. Needs no GPU: this image only compiles.
#   just ptx
FROM nvcr.io/nvidia/cuda:13.3.1-cudnn-devel-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get -qq -y install build-essential clang curl libssl-dev libtinfo-dev \
      libxml2-dev libzstd-dev pkg-config xz-utils zlib1g-dev && rm -rf /var/lib/apt/lists/*
RUN curl -sSf -L https://sh.rustup.rs | bash -s -- -y --profile minimal --default-toolchain none
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup toolchain install nightly-2026-04-02 --profile minimal \
      -c rust-src -c rustc-dev -c llvm-tools-preview
ENV LD_LIBRARY_PATH="/usr/local/cuda/nvvm/lib64:${LD_LIBRARY_PATH}"
ENV USE_PREBUILT_LLVM=1
