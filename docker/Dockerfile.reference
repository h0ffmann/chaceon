# syntax=docker/dockerfile:1
# The Fortran reference: metocean/WW3 at the pin, built by WW3's own CMake, for linux/arm64. Nothing
# of chaceon enters it except the switch file. -ffp-contract=off: docs/ADRs/ADR-0005.
#   just ref-build
FROM debian:bookworm-slim AS build
ARG DEBIAN_FRONTEND=noninteractive
ARG WW3_REPO=https://github.com/metocean/WW3
ARG WW3_REF=92e2cf66af6e15ae80eb12562f2b05d4a2d75df5
ARG WW3_VERSION=7.14
ARG WW3_SWITCH_FILE=switch_chaceon_shrd
RUN apt-get update && apt-get install -y --no-install-recommends \
      gfortran g++ cmake make git pkg-config ca-certificates \
      libnetcdf-dev libnetcdff-dev libhdf5-dev \
 && rm -rf /var/lib/apt/lists/*
COPY switches/ /switches/
RUN git init -q /src && git -C /src fetch -q --depth 1 "${WW3_REPO}" "${WW3_REF}" \
 && git -C /src checkout -q FETCH_HEAD \
 && test "$(cat /src/VERSION)" = "${WW3_VERSION}"
RUN cmake -S /src -B /build -DSWITCH="/switches/${WW3_SWITCH_FILE}" -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_Fortran_FLAGS=-ffp-contract=off -DCMAKE_INSTALL_PREFIX=/opt/ww3 \
 && cmake --build /build -j"$(nproc)" \
 && mkdir -p /opt/ww3/bin && cp /build/bin/ww3_* /opt/ww3/bin/ \
 && for p in grid strt prnc shel ounf ounp; do test -x "/opt/ww3/bin/ww3_$p"; done \
 && { echo "WW3 ${WW3_VERSION} ${WW3_REPO} ${WW3_REF}"; echo "switch: $(cat /switches/${WW3_SWITCH_FILE})"; \
      echo "arch: $(uname -m), extra flags: -ffp-contract=off"; gfortran --version | head -1; ldd --version | head -1; } > /opt/ww3/BUILD_INFO

FROM debian:bookworm-slim AS dist
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends libnetcdff7 libgfortran5 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/ww3/bin/ /usr/local/bin/
COPY --from=build /opt/ww3/BUILD_INFO /usr/local/share/ww3/BUILD_INFO
