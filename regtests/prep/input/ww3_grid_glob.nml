! ww3_prep interpolation tests: a small spherical grid, made by scripts/prep_interp.sh
&SPECTRUM_NML
  SPECTRUM%XFR       =  1.1
  SPECTRUM%FREQ1     =  0.040
  SPECTRUM%NK        =  9
  SPECTRUM%NTH       =  24
/
&RUN_NML
  RUN%FLCX         =  T
  RUN%FLCY         =  T
  RUN%FLCTH        =  T
/
&TIMESTEPS_NML
  TIMESTEPS%DTMAX        =  2200.
  TIMESTEPS%DTXY         =  2200.
  TIMESTEPS%DTKTH        =  2200.
  TIMESTEPS%DTMIN        =  2200.
/
&GRID_NML
  GRID%NAME         =  'PREP INTERPOLATION glob'
  GRID%NML          =  '../input/namelists_2-D.nml'
  GRID%TYPE         =  'RECT'
  GRID%COORD        =  'SPHE'
  GRID%CLOS         =  'SMPL'
  GRID%ZLIM         =  -5.
  GRID%DMIN         =  5.75
/
&RECT_NML
  RECT%NX           =  24
  RECT%NY           =  7
  RECT%SX           =  15.
  RECT%SY           =  15.
  RECT%X0           =  0.
  RECT%Y0           =  -45.
/
&DEPTH_NML
  DEPTH%SF        =  -2500.
  DEPTH%FILENAME  =  '../input/prep_glob.depth'
  DEPTH%IDLA      =  1
/
